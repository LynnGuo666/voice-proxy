# Server port
PORT=3000

# Referer whitelist (comma-separated)
# Examples:
#   https://example.com
#   https://*.example.com
#   https://app.example.com,https://web.example.com
ALLOWED_REFERERS=https://example.com

# Allow requests with empty Referer header (direct access)
# Set to "true" to allow, "false" to deny
ALLOW_EMPTY_REFERER=false

# Cache TTL for media segments (seconds)
# Default: 86400 (1 day)
CACHE_MEDIA_TTL=86400

# Cache TTL for manifests (m3u8, mpd) (seconds)
# Default: 30
CACHE_MANIFEST_TTL=30
